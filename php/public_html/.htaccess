# 9 Minnutes – Apache settings (cPanel). Safe to keep if the host ignores some lines.
Options -Indexes
DirectoryIndex index.php

# Correct file types (Safari refuses video served with the wrong type, and nosniff is on)
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>
# Never compress video: iPhone/iPad Safari streams it in byte ranges
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "\.mp4$" no-gzip dont-vary
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Never serve hidden files, PHP includes or a private folder placed inside public_html.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files "boot.php">
  Require all denied
</Files>
RedirectMatch 404 ^/private(/|$)

# Force HTTPS (uncomment once the SSL certificate is active)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
