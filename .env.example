# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to the repository.

# Required: the ClientId header value Farvision gave Realmark (treat it like a password).
FARVISION_CLIENT_ID=

# Optional overrides (defaults shown). PRODUCT and CAMPAIGN must match exactly what is created in Farvision.
FARVISION_API_URL=https://fvintegration.farvisioncloud.com/LeadSync/api/SyncLeadsV2/RawLeads
FARVISION_PRODUCT=REALMARK 9 MINNUTES
FARVISION_CAMPAIGN=9 Minnutes Microsite

# Optional safety net: a webhook that receives a copy of every lead (e.g. Google Apps Script → Sheet + email).
BACKUP_WEBHOOK_URL=
